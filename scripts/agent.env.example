# =====================================================================
# Databricks Migration AI Studio - Universal Local Agent Configuration
# =====================================================================
# Place this file as 'agent.env' in the same folder as migration-agent.exe
# and double-click migration-agent.exe to connect!

# The URL of your hosted Migration AI Studio (e.g. your Render link)
CONNECTOR_URL=

# Source Profile ID shown in Migration AI Studio UI
CONNECTOR_SOURCE=

# Engine type: SQLSERVER, MYSQL, POSTGRESQL, or ORACLE
CONNECTOR_ENGINE=MYSQL

# Host/Server instance (e.g. localhost, 127.0.0.1, or localhost\SQLEXPRESS)
CONNECTOR_SERVER=localhost

# Port (3306 for MySQL, 5432 for PostgreSQL, 1433 for SQL Server, 1521 for Oracle)
CONNECTOR_PORT=3306

# Target Database name (e.g. EcommerceMigrationDemo)
CONNECTOR_DATABASE=EcommerceMigrationDemo

# Schema name (e.g. public for PostgreSQL, leave blank for MySQL)
CONNECTOR_SCHEMA=

# One-time registration token generated from the Studio UI
CONNECTOR_TOKEN=

# Database Credentials
CONNECTOR_USERNAME=root
CONNECTOR_PASSWORD=your_password_here

# SQL Server specific settings (ignored for MySQL/PostgreSQL/Oracle)
CONNECTOR_DRIVER=ODBC Driver 18 for SQL Server
CONNECTOR_TRUST_CERT=false

# Dashboard tries alternatives and an OS-assigned port if this is occupied.
CONNECTOR_DASHBOARD_PORT=8585
