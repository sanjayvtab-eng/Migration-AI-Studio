# =====================================================================
# Databricks Migration AI Studio - Local Agent Configuration
# =====================================================================
# Place this file as 'agent.env' in the same folder as migration-agent.exe
# and double-click migration-agent.exe to connect!

# The URL of your hosted Migration AI Studio
CONNECTOR_URL=https://databricks-migration-factory-819s.onrender.com

# Source Profile ID shown in Migration AI Studio UI
CONNECTOR_SOURCE=SRC_da3eaf864506385d

# One-time registration token generated from the Studio UI
CONNECTOR_TOKEN=

# SQL Server instance (e.g. localhost\SQLEXPRESS or SHANJI\SQLEXPRESS)
CONNECTOR_SERVER=localhost\SQLEXPRESS

# Database name to inspect and migrate
CONNECTOR_DATABASE=UniversityDB

# ODBC Driver name (default is ODBC Driver 17 for SQL Server)
CONNECTOR_DRIVER=ODBC Driver 17 for SQL Server

# Trust SQL Server self-signed certificates (recommended for local SQL Express)
CONNECTOR_TRUST_CERT=true

# Optional: SQL Authentication (leave blank to use current Windows account)
CONNECTOR_USERNAME=
CONNECTOR_PASSWORD=
