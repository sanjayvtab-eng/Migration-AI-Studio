ENVIRONMENT=DEV
JWT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

SQLSERVER_HOST=localhost
SQLSERVER_DATABASE=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SOURCE_DB_ENGINE=SQLSERVER

# PostgreSQL (used when a source profile does not provide an override)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_SCHEMA=public
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_SSL_MODE=prefer

# MySQL / MariaDB
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4

# Oracle Thin mode (no Instant Client required)
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
ORACLE_SCHEMA=
ORACLE_USERNAME=
ORACLE_PASSWORD=
SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=

DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
# Release 1 safety gate. Enable only after the project connection test and RBAC review.
DATABRICKS_ENVIRONMENT_PROVISIONING_ENABLED=false
# Add one runtime secret per client when project configuration uses a custom token reference:
# CLIENT_A_DATABRICKS_TOKEN=
DEV_CATALOG=migration_dev
TEST_CATALOG=migration_test
UAT_CATALOG=migration_uat
PROD_CATALOG=migration_prod
CONTROL_CATALOG=migration_control
CONTROL_SCHEMA=migration_control

# Governed AI remediation. Deterministic rules always run first.
# Local Ollama requires no API key and is the recommended development provider.
LLM_ENABLED=false
LLM_PROVIDER=OLLAMA
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=
LLM_MODEL=qwen2.5-coder:3b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=3
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=4096
LLM_MAX_PROMPT_CHARS=160000
OLLAMA_KEEP_ALIVE=5m

# Gemini alternative (keep the real key only in .env; never commit it):
# LLM_ENABLED=true
# LLM_PROVIDER=GEMINI
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_API_KEY=<your-gemini-api-key>
# LLM_MODEL=gemini-3.5-flash

DEPLOYMENT_POLICY=FAIL_ON_SCHEMA_DRIFT
DEV_SCHEMA_POLICY=REPLACE_CHANGED
BATCH_SIZE=10000
# Optional integer row cap for testing. Leave the variable commented for unlimited rows.
# MAX_ROWS=1000
PARALLELISM=4
LOAD_MODE=FULL_LOAD
SOURCE_TIMESTAMP_TIMEZONE=UTC

# Release 7 prompt-native artifact design
PROMPT_NATIVE_DESIGN_ENABLED=true
DATABRICKS_SQL_PROCEDURES_SUPPORTED=false
PROMPT_TARGET_VALIDATION_REQUIRED=true
